# Flutter / Dart
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.iml

# Never commit a built site. It is regenerated by `flutter build web`, and a
# stale copy in the repo is how somebody deploys last month's app by accident.
web/build/

# Editors
.idea/
.vscode/
*.swp

# macOS
.DS_Store

# Supabase local state
supabase/.temp/
supabase/.branches/
supabase/config.toml

# Secrets. These should never exist in this project at all — keys live in
# Supabase Edge Function secrets, not in files — but the rule is here in case
# somebody adds one later.
.env
.env.*
*.key
*.pem
service_role*
